# ---- Auth (never commit real values) ----
# Option A: shared secret (simple / break-glass)
LITELLM_MASTER_KEY=

# Option B: ask North America to allow (recommended with Tokyo MFA)
# Client → Cloud Run with access JWT; Cloud Run asks NA only when:
#   - first time / no cache, or
#   - request IP != JWT login_ip
# Same login_ip + JWT not expired → local cache, no NA call.
# NA_VERIFY_URL=http://gcp.nzysxc.com:8789/v1/auth/verify
# SERVERLESS_TO_NA_SECRET=same-as-NA-if-set

# Option C: local RS256 (optional; same-IP can skip NA if key present)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PUBLIC_KEY_FILE=./keys/public.pem
# JWT_ISSUER=litellm-mfa-tokyo
# JWT_AUDIENCE=serverless-litellm

# ---- Vertex Gemini (GCP free-trial / billing credits) ----
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global
# Local only (Cloud Run uses metadata SA automatically):
# VERTEX_ACCESS_TOKEN=

# ---- Optional other providers ----
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# RUST_LOG=serverless_litellm=info
