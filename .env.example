# Gateway master key — clients send: Authorization: Bearer <this>
LITELLM_MASTER_KEY=sk-change-me

# ---- Vertex AI Claude (scheme B) ----
# Project id (or leave empty on Cloud Run to read from metadata)
GCP_PROJECT=your-gcp-project-id
# Claude is often in us-east5; also try europe-west1 or global
GCP_LOCATION=us-east5
# Local only (Cloud Run uses metadata SA token automatically):
# VERTEX_ACCESS_TOKEN=

# ---- Gemini (AI Studio) — gemini-3.6-flash / gemini-flash / default ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional other providers ----
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PORT=4000
# RUST_LOG=serverless_litellm=info
