# ---- Auth (never commit real values) ----
# Option A: shared secret (simple)
LITELLM_MASTER_KEY=

# Option B: RS256 JWT — public key only on server (see docs/jwt-auth.md)
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# JWT_PUBLIC_KEY_FILE=./keys/public.pem
# JWT_ISSUER=
# JWT_AUDIENCE=

# ---- Vertex Gemini (GCP free-trial / billing credits) ----
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global
# Local only (Cloud Run uses metadata SA automatically):
# VERTEX_ACCESS_TOKEN=

# ---- Optional other providers ----
# GEMINI_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# RUST_LOG=serverless_litellm=info
